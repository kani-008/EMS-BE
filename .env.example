# ─── Auth Database (Credentials) ──────────────────────────────────────────────
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=
AUTH_DB_NAME=credentials

# ─── Event Database (Event_Management) ────────────────────────────────────────
EVENT_DB_HOST=localhost
EVENT_DB_PORT=5432
EVENT_DB_USER=postgres
EVENT_DB_PASSWORD=
EVENT_DB_NAME=event_management

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=5000

# ─── Frontend ──────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_SALT=10

# ─── Debug ─────────────────────────────────────────────────────────────────────
AUTH_DEBUG=false
